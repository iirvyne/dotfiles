; sup cuh

(defpoll DAY :interval "1s" '~/.config/eww/scripts/day_format.sh')
(defpoll MONTH :interval "1s" '~/.config/eww/scripts/month_format.sh')
(defpoll YEAR :interval "1s" '~/.config/eww/scripts/year_format.sh')

(defpoll CAVA :interval "0.03s" 'cat /tmp/eww_visualizer.txt')

(defpoll TIME :interval "1s" "date '+%H:%M %p'")

(defpoll WINDOW :interval "0.03s" '~/.config/hypr/scripts/eww-window.sh')

(defpoll CPU :interval "1s" 'bash ~/.config/hypr/scripts/eww-cpuinfo.sh')
(defpoll GPU :interval "1s" 'bash ~/.config/hypr/scripts/eww-gpuinfo.sh')
(defpoll MEM :interval "1s" 'bash ~/.config/hypr/scripts/eww-meminfo.sh')

(defpoll VOL :interval "0.03s" 'bash ~/.config/hypr/scripts/eww-volinfo.sh')

(defvar workspaces-output "
  (box 
  :class \"taskbar-button\" 
  :halign \"end\" 
  :valign \"center\"
  :orientation \"h\" 
  :spacing 3 
  :space-evenly \"false\" 

    (eventbox 
    :onclick \"hyprctl dispatch workspace 1\" 
    :cursor \"pointer\" 
    :class \"free\" 
      (label
      :text \"1 \"
      )
    ) 

    (eventbox 
    :onclick \"hyprctl dispatch workspace 2\" 
    :cursor \"pointer\" 
    :class \"free\" 
      (label 
      :text \"2 \"
      )
    )

    (eventbox 
    :onclick \"hyprctl dispatch workspace 3\" 
    :cursor \"pointer\" 
    :class \"free\" 
      (label 
      :text \"3 \"
      )
    ) 

    (eventbox 
    :onclick \"hyprctl dispatch workspace 4\" 
    :cursor \"pointer\" 
    :class \"free\" 
      (label 
      :text \"4 \"
      )
    ) 

    (eventbox 
    :onclick \"hyprctl dispatch workspace 5\" 
    :cursor \"pointer\" 
    :class \"free\" 
      (label 
      :text \"5 \"
      )
    )

  )
")


