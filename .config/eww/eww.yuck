; gets widgets.yuck
(include "eww_widgets.yuck")

; widgets
(defwindow daybox
:monitor '[1]'
:stacking "bg"
:namespace "eww"
:geometry 
  (geometry
  :x "260"
  :y "20"
  :width "100"
  :height "100"
  :anchor "bottom right"
  )
  (daybox)
)

