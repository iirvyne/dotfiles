; taskbar
(defwindow taskbar
:monitor 1
:stacking "fg"  
:exclusive true
:geometry 
  (geometry 
  :anchor "bottom center"
  :width "100%"
  :height "3.3%"
  )
  (taskbar)
)


(defwindow taskbar-calendar
:monitor 1
:stacking "overlay"
:geometry
  (geometry
  :anchor "bottom center"
  :wdith "150"
  :height "200"
  )
  (taskbar-calendar)
)

(defwindow calendar
:monitor 1
:stacking "overlay"
:geometry
  (geometry
  :anchor "bottom center"
  :wdith "150"
  :height "200"
  )
  (taskbar-calendar)
)
