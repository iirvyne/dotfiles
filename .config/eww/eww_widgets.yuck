(include "eww_vars.yuck")

(defwidget daybox []
  (box :height "100" :width "100" :halign "center" :valign "center" :class "container"
    (label :class "label"  :text DAY)
  )
)

(defwidget monthbox []
  (box :height "100" :width "100" :halign "center" :valign "center" :class "container"
    (label :class "label"  :text MONTH)
  )
)

(defwidget yearbox []
  (box :height "100" :width "100" :halign "center" :valign "center" :class "container"
    (label :class "label"  :text YEAR)
  )
)

(defwidget userinfobox []
  (centerbox :height "100" :width "300" :halign "center" :valign "center" :class "userinfo-parent"
    (box :height "100" :width "112" :halign "center" :valign "center" :class "userinfo-child"
      (button :onclick "kitty --directory ~ & cd ~ & disown" :class "button"
        (label :class "icon-label"  :text "")
      )
    )
    (box :height "100" :width "112" :halign "center" :valign "center" :class "userinfo-child"
      (button :onclick "thunar ~ & disown"  :class "button"
        (label :class "icon-label"  :text "󰉋")
      )
    )
    (box :height "100" :width "112" :halign "center" :valign "center" :class "userinfo-child"
      (button :onclick "kitty cava & disown" :class "button"
        (label :class "icon-label"  :text "")
      )
    )
  )
)


(defwidget cava []
  (box :height "100" :width "340" :halign "bottom" :valign "bottom" :class "container"
    (label :class "label" :halign "bottom" :valign "end" :text CAVA)
  )
)


(defwidget taskbar []
  (box
  :orientation "horizontal" :class "taskbar-container"
    (box
    :halign "start"
    :class "taskbar-container"
      (bar-window)
      (box)
      (bar-cava)
    )

    (box
    :halign "center"
    :class "taskbar-container"
      (bar-workspaces)
      (bar-clock)
    )

    (box
    :halign "end"
    :class "taskbar-container"
      (bar-info)
      (bar-menu)
    )
  )
)



(defwidget bar-window []
  (button
  :spacing "8"
  :padding "4px"
  :class "taskbar-button"
    (label
    :text " ${WINDOW}"
    )
  ) 
)

(defwidget bar-cava []
  (button
  :halign "end"
  :spacing "8"
  :padding "4px"
  :class "taskbar-button"
  :onclick "kitty cava &"
    (label
    :text CAVA
    )
  )
)

(defwidget bar-workspaces []
  (literal
  :content workspaces-output
  :valign "center"
  :class "taskbar-button"
  )
)

(defwidget bar-clock []
  (button
  :class "taskbar-button"
    :halign "center"
    (label
    :text "󰥔 ${TIME}"
    :class "taskbar-label"
    )
  )
)

(defwidget bar-info []
  (box
  :spacing 8
  :halign "start"
    (button
    :class "taskbar-button"
    :halign "end"
      (label
      :text "󰍛 ${CPU}"
      :class "taskbar-label"
      )
    )
    (button
    :class "taskbar-button"
    :halign "start"
    :padding "2px"
      (label
      :text "󰾆 ${MEM}"
      )
    )
    (button
    :class "taskbar-button"
    :padding "2px"
    :halign "start"
      (label
      :text " ${GPU}"
      )
    )

 (eventbox
    :halign ""
    :onscroll "
    if [ '{}' = 'up' ]; then
      $HOME/.config/hypr/scripts/volumecontrol.sh -o i;
    else 
      $HOME/.config/hypr/scripts/volumecontrol.sh -o d;
    fi
    "
    (button
    :spacing 4
    :class "taskbar-button"
    :onclick "pavucontrol -t 3 &"
      (label
      :text " ${VOL}"
      )
    )
  )


  )
)



(defwidget bar-menu []
  (box
  :halign "end"
  :spacing 16
  :padding "8px 16px 8px 16px"
    (button
    :class "taskbar-button"
    :onclick "rofi -show drun & "
      (label
      :text "󰉋"
      )
    )

    (button
    :class "taskbar-button"
    :onclick "$HOME/.config/hypr/scripts/cliphist.sh c"
      (label
      :text "󰅇"
      )
    )

    (button
    :class "taskbar-button"
    :onclick "$HOME/.config/hypr/scripts/logoutlaunch.sh 2"
      (label
      :text ""
      )
    )
  )
)


